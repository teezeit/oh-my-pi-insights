{
  "name": "oh-my-pi-insights",
  "version": "1.2.3",
  "type": "module",
  "description": "omp Insights extension — generates a personal usage insights report from your omp session history",
  "author": "Hari Srinivasan <harisrini21@gmail.com>",
  "contributors": [
    "Tobias Hoelzer (omp port)"
  ],
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teezeit/oh-my-pi-insights.git"
  },
  "homepage": "https://github.com/teezeit/oh-my-pi-insights#readme",
  "bugs": {
    "url": "https://github.com/teezeit/oh-my-pi-insights/issues"
  },
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "test": "node --test --experimental-strip-types 'test/*.test.ts'",
    "test:update-golden": "UPDATE_GOLDEN=1 node --test --experimental-strip-types test/report.test.ts",
    "typecheck": "tsc --noEmit --strict --target es2022 --module esnext --moduleResolution bundler --allowImportingTsExtensions --skipLibCheck --types node index.ts test/*.ts",
    "verify:cost": "./tools/verify-cost.sh"
  },
  "keywords": [
    "omp-extension",
    "insights",
    "usage-analytics",
    "ai-agent",
    "coding-agent"
  ],
  "omp": {
    "extensions": [
      "./"
    ]
  },
  "files": [
    "index.ts",
    "README.md",
    "tools/verify-cost.sh"
  ]
}
